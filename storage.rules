rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Notes images (notes_images/ folder used by React-Quill note editor)
    match /notes_images/{allPaths=**} {
      allow read: if true;
      allow write: if (isSignedIn() || true) &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Note images (noteImages/ folder)
    match /noteImages/{allPaths=**} {
      allow read: if true;
      allow write: if (isSignedIn() || true) &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Educational materials & note illustrations
    match /materials/{allPaths=**} {
      allow read: if true;
      allow write: if (isSignedIn() || true) && 
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Announcement images
    match /announcementImages/{announcementId}/{fileName} {
      allow read: if true;
      allow write: if (isSignedIn() || true) && 
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // User profile avatars
    match /profileImages/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) || isSignedIn();
    }

    // Legacy avatar folder compatibility
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) || isSignedIn();
    }
  }
}

