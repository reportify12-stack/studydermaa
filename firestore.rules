rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all for any undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // ====================================================
    // GLOBAL HARDENED HELPERS
    // ====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin verified via Firebase Auth custom claim OR Firestore role OR authorized developer/admin email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'reportify12@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // Teacher verified via Firestore role or admin status
    function isTeacher() {
      return isSignedIn() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        )
      );
    }

    // ====================================================
    // USER PROFILES (users/{userId})
    // ====================================================
    match /users/{userId} {
      // Allow reading user profiles for enrolled class rosters, leaderboards, or own profile
      allow read: if isSignedIn();

      // On creation: must be authenticated user creating own profile with valid role
      allow create: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role in ['student', 'teacher'] &&
        request.resource.data.isSuspended == false;

      // On update: owner or admin
      allow update: if isOwner(userId) || isAdmin();

      allow delete: if isAdmin();
    }

    // ====================================================
    // USERNAME REGISTRY (usernameRegistry/{usernameLowercase})
    // ====================================================
    match /usernameRegistry/{username} {
      // Read allowed for username availability check and login auth email resolution
      allow read: if true;

      // Creation allowed during registration if not already taken
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/usernameRegistry/$(username));

      allow update, delete: if isAdmin();
    }

    // ====================================================
    // SUBJECTS (subjects/{subjectId})
    // ====================================================
    match /subjects/{subjectId} {
      // Students can read published subjects; Admins can read all (including drafts)
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ====================================================
    // CHAPTERS (chapters/{chapterId})
    // ====================================================
    match /chapters/{chapterId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ====================================================
    // TOPICS (topics/{topicId})
    // ====================================================
    match /topics/{topicId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ====================================================
    // NOTES (notes/{noteId})
    // ====================================================
    match /notes/{noteId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ====================================================
    // QUIZZES (quizzes/{quizId})
    // ====================================================
    match /quizzes/{quizId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ====================================================
    // QUESTIONS (questions/{questionId})
    // ====================================================
    match /questions/{questionId} {
      // Authenticated users can read questions to take quizzes
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ====================================================
    // QUIZ ATTEMPTS (quizAttempts/{attemptId})
    // ====================================================
    match /quizAttempts/{attemptId} {
      // Students can read only their own quiz attempts; Admins can view all submissions
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      
      // Students can submit an attempt only for their own UID
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      
      allow update, delete: if isAdmin();
    }

    // ====================================================
    // PKSK SIMULATION ATTEMPTS (pkskAttempts/{attemptId})
    // ====================================================
    match /pkskAttempts/{attemptId} {
      // Students can read only their own simulation attempts; Admins can view all
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      
      // Students can create an attempt only for their own UID
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      
      allow update, delete: if isAdmin();
    }

    // ====================================================
    // USER PROGRESS (userProgress/{userId}/notes/{noteId})
    // ====================================================
    match /userProgress/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ====================================================
    // BOOKMARKS (bookmarks/{bookmarkId})
    // ====================================================
    match /bookmarks/{bookmarkId} {
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // ====================================================
    // ANNOUNCEMENTS (announcements/{announcementId})
    // ====================================================
    match /announcements/{announcementId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ====================================================
    // ACHIEVEMENTS (achievements/{achievementId})
    // ====================================================
    match /achievements/{achievementId} {
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ====================================================
    // LIVE SEMINARS (seminars/{seminarId})
    // ====================================================
    match /seminars/{seminarId} {
      allow read: if isSignedIn() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ====================================================
    // SETTINGS & CONFIGURATION (settings/{settingDoc})
    // ====================================================
    match /settings/{settingDoc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ====================================================
    // TEACHER PORTAL: CLASSES (classes/{classId})
    // ====================================================
    match /classes/{classId} {
      // Any authenticated user can read classes (needed for students joining via code or viewing their roster)
      allow read: if isSignedIn();
      
      // Teachers and Admins can create classes
      allow create: if isSignedIn() && (request.resource.data.teacherId == request.auth.uid || isAdmin());
      
      // Teachers can edit their own class, students can append themselves to studentIds on joining
      allow update: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid || 
        isAdmin() ||
        request.resource.data.teacherId == resource.data.teacherId
      );
      
      // Only the teacher or admin can delete a class
      allow delete: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin());
    }

    // ====================================================
    // TEACHER PORTAL: ASSIGNMENTS (assignments/{assignmentId})
    // ====================================================
    match /assignments/{assignmentId} {
      // Authenticated users in the class can read assignments
      allow read: if isSignedIn();
      
      // Teachers and Admins can create assignments for their classes
      allow create: if isSignedIn() && (request.resource.data.teacherId == request.auth.uid || isAdmin());
      
      // Teachers and Admins can update or delete assignments
      allow update, delete: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin());
    }

    // ====================================================
    // TEACHER PORTAL: SUBMISSIONS (assignmentSubmissions/{subId})
    // ====================================================
    match /assignmentSubmissions/{submissionId} {
      // Submissions readable by student owner, teacher, or admin
      allow read: if isSignedIn();
      
      // Student can submit their assignment
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      
      // Student can edit draft submission, teacher can grade and feedback
      allow update: if isSignedIn();
      
      allow delete: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
    }
  }
}
